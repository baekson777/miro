{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p public && cp -r docs/. public/",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/privacy-policy", "destination": "/privacy" },
    { "source": "/delete-account", "destination": "/account-deletion" },
    { "source": "/legal/privacy", "destination": "/privacy" },
    { "source": "/legal/account-deletion", "destination": "/account-deletion" },
    { "source": "/legal/privacy.html", "destination": "/privacy" },
    { "source": "/legal/account-deletion.html", "destination": "/account-deletion" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
